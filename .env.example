# Praveen Garments — environment variables
# Copy to .env and fill in the real values from your Supabase dashboard
# (Project Settings → API). NEVER commit the real .env file.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Browser-safe publishable/anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# SERVER-ONLY service role key — grants full database access.
# Used exclusively by /api/admin routes on the server. Never import in
# client components; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY
